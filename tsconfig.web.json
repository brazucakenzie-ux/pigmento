{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "rootDir": ".",
    "outDir": "out/.tsc-web",
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@engine/*": ["./src/renderer/src/engine/*"],
      "@ui/*": ["./src/renderer/src/ui/*"]
    }
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*", "tests/unit/**/*"]
}
