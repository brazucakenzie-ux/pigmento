{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "rootDir": ".",
    "outDir": "out/.tsc-e2e",
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["tests/e2e/**/*", "src/shared/**/*"]
}
