<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app" (slug: app), for the release workflow's first signing
     request: Pigmento.exe and the NSIS uninstaller (docs/releasing.md). Electron's own DLLs and
     electron-builder's elevate.exe are upstream files and stay as they are. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Pigmento.exe" product-name="Pigmento" product-version="${version}.0">
      <authenticode-sign />
    </pe-file>
    <pe-file path="uninstaller.exe" product-name="Pigmento" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
