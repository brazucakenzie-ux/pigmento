{
  "name": "pigmento",
  "productName": "Pigmento",
  "version": "1.4.0",
  "description": "Pigmento: Paint simply. Create boldly.",
  "main": "./out/main/index.js",
  "author": "brazucakenzie",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:e2e",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run e2e",
    "icons": "node scripts/build-icons.mjs",
    "notices": "node scripts/notices.mjs",
    "mcp-docs": "node scripts/mcp-docs.mjs",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "dist": "npm run build && electron-builder --win --publish never && node scripts/checksums.mjs",
    "smoke:installed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-installed.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "globals": "^17.14.0",
    "lucide-react": "^1.69.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}
