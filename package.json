{
  "name": "pigmento",
  "productName": "Pigmento",
  "version": "0.1.0",
  "description": "Pigmento: Paint simply. Create boldly.",
  "main": "./out/main/index.js",
  "author": "brazucakenzie",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:e2e",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run e2e",
    "icons": "node scripts/build-icons.mjs",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gifenc": "^1.0.3",
    "globals": "^17.14.0",
    "lucide-react": "^1.69.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}
